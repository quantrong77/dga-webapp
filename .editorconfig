# .editorconfig — thiết lập chung cho mọi trình soạn thảo (VS Code, Antigravity...).
# KHÔNG ép kiểu xuống dòng (repo đang lẫn LF/CRLF; Prettier để "auto" giữ nguyên từng file).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
